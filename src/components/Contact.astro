---
import { siteConfig } from "../config";
import { t } from "../i18n/index";

interface Props {
  lang?: string;
}

const { lang = "pt" } = Astro.props;
const web3formsKey = import.meta.env.WEB3FORMS_KEY || "";
---

<section id="contact" class="py-24 px-6 bg-neutral-50 dark:bg-neutral-900/50">
  <div class="max-w-5xl mx-auto">
    <h2
      class="text-3xl font-bold text-neutral-900 dark:text-white mb-2 tracking-tight"
    >
      {t("contact.title", lang)}
    </h2>
    <div
      class="w-16 h-1 mb-10 rounded-full"
      style={`background-color: ${siteConfig.accentColor}`}
    ></div>

    <div class="max-w-xl">
      <form
        id="contact-form"
        class="space-y-5"
      >
        <div>
          <label for="contact-name" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1.5">
            {t("contact.name", lang)}
          </label>
          <input
            type="text"
            id="contact-name"
            name="name"
            required
            class="w-full px-4 py-2.5 text-sm rounded-lg border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-800 text-neutral-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-offset-0 transition-shadow"
            style={`--tw-ring-color: ${siteConfig.accentColor}`}
          />
        </div>
        <div>
          <label for="contact-email" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1.5">
            {t("contact.email", lang)}
          </label>
          <input
            type="email"
            id="contact-email"
            name="email"
            required
            class="w-full px-4 py-2.5 text-sm rounded-lg border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-800 text-neutral-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-offset-0 transition-shadow"
            style={`--tw-ring-color: ${siteConfig.accentColor}`}
          />
        </div>
        <div>
          <label for="contact-message" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1.5">
            {t("contact.message", lang)}
          </label>
          <textarea
            id="contact-message"
            name="message"
            rows="5"
            required
            class="w-full px-4 py-2.5 text-sm rounded-lg border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-800 text-neutral-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-offset-0 transition-shadow resize-none"
            style={`--tw-ring-color: ${siteConfig.accentColor}`}
          ></textarea>
        </div>
        <button
          type="submit"
          id="contact-submit"
          class="px-6 py-2.5 text-sm font-medium text-white rounded-lg transition-all hover:opacity-90 hover:shadow-lg disabled:opacity-50 disabled:cursor-not-allowed"
          style={`background-color: ${siteConfig.accentColor}`}
        >
          {t("contact.send", lang)}
        </button>
        <div id="contact-status" class="hidden text-sm mt-3"></div>
      </form>
    </div>
  </div>
</section>

<script define:vars={{ email: siteConfig.social.email, successMsg: t("contact.success", lang), errorMsg: t("contact.error", lang), w3fKey: web3formsKey }}>
  const form = document.getElementById("contact-form");
  const status = document.getElementById("contact-status");
  const submitBtn = document.getElementById("contact-submit");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const name = formData.get("name");
    const senderEmail = formData.get("email");
    const message = formData.get("message");

    submitBtn.disabled = true;
    submitBtn.textContent = "...";

    try {
      const res = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          access_key: w3fKey,
          name,
          email: senderEmail,
          message,
          to: email,
        }),
      });

      if (res.ok) {
        status.textContent = successMsg;
        status.className = "text-sm mt-3 text-green-600 dark:text-green-400";
        form.reset();
      } else {
        throw new Error();
      }
    } catch {
      status.textContent = errorMsg;
      status.className = "text-sm mt-3 text-red-600 dark:text-red-400";
    }

    status.classList.remove("hidden");
    submitBtn.disabled = false;
    submitBtn.textContent = form.querySelector("button").dataset.label || "Send";
  });
</script>
