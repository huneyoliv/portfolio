---
import { siteConfig } from "../config";
import { t } from "../i18n/index";

interface Props {
  lang?: string;
  translatedAboutMe?: string;
  skills?: string[];
}

const { lang = "pt", translatedAboutMe, skills } = Astro.props;
const aboutMe = translatedAboutMe || siteConfig.aboutMe;
const displaySkills = skills || siteConfig.skills;
---

{siteConfig.aboutMe && (
  <section id="about" class="py-24 px-6">
    <div class="max-w-5xl mx-auto">
      <h2
        class="text-3xl font-bold text-neutral-900 dark:text-white mb-2 tracking-tight"
      >
        {t("about.title", lang)}
      </h2>
      <div
        class="w-16 h-1 mb-10 rounded-full"
        style={`background-color: ${siteConfig.accentColor}`}
      ></div>

      <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed text-lg max-w-3xl mb-12">
        {aboutMe}
      </p>

      {displaySkills && displaySkills.length > 0 && (
        <div class="flex flex-wrap justify-center gap-3 max-w-3xl mx-auto">
          {displaySkills.map((skill) => (
            <span class="px-5 py-2 text-sm font-medium rounded-full bg-neutral-100 dark:bg-[#1f1f1f] text-neutral-800 dark:text-neutral-200 border border-neutral-300 dark:border-white/10 shadow-sm transition-all hover:bg-neutral-200 dark:hover:bg-[#292929] flex items-center">
              {skill}
            </span>
          ))}
        </div>
      )}
    </div>
  </section>
)}
