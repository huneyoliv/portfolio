---
import { siteConfig } from "../config";
import { t } from "../i18n/index";

interface Props {
  lang?: string;
  translatedAboutMe?: string;
  skills?: string[];
}

const { lang = "pt", translatedAboutMe, skills } = Astro.props;
const aboutMe = translatedAboutMe || siteConfig.aboutMe;
const displaySkills = skills || siteConfig.skills;

let skillsList: string[] = [];
try {
  const res = await fetch("https://raw.githubusercontent.com/huneyoliv/huneyoliv/refs/heads/main/README.md");
  if (res.ok) {
    const text = await res.text();
    const match = text.match(/https:\/\/skillicons\.dev\/icons\?i=([a-zA-Z0-9_,]+)/);
    if (match && match[1]) {
      skillsList = match[1].split(",");
    }
  }
} catch (e) {}

const finalSkills = skillsList.length > 0 ? skillsList : displaySkills;
---

{siteConfig.aboutMe && (
  <section id="about" class="py-24 px-6">
    <div class="max-w-5xl mx-auto">
      <h2
        class="text-3xl font-bold text-neutral-900 dark:text-white mb-2 tracking-tight"
      >
        {t("about.title", lang)}
      </h2>
      <div
        class="w-16 h-1 mb-10 rounded-full"
        style={`background-color: ${siteConfig.accentColor}`}
      ></div>

      <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed text-lg max-w-3xl mb-12">
        {aboutMe}
      </p>

      {finalSkills && finalSkills.length > 0 && (
        <div class="mt-8 relative w-full overflow-hidden flex justify-center py-6 [mask-image:_linear-gradient(to_right,transparent_0,_black_128px,_black_calc(100%-128px),transparent_100%)]">
          <div class="flex w-max min-w-full animate-[scroll_20s_linear_infinite] hover:[animation-play-state:paused] group items-center">
            <div class="flex flex-1 gap-6 pr-6">
              {finalSkills.map((skill) => (
                <img
                   src={`https://skillicons.dev/icons?i=${skill}`}
                   alt={skill}
                   loading="lazy"
                   class="h-12 w-12 min-w-12 max-w-12 hover:scale-150 relative transition-transform duration-300 cursor-pointer object-cover hover:z-50"
                />
              ))}
            </div>
            <div class="flex flex-1 gap-6 pr-6" aria-hidden="true">
              {finalSkills.map((skill) => (
                <img
                   src={`https://skillicons.dev/icons?i=${skill}`}
                   alt={skill}
                   loading="lazy"
                   class="h-12 w-12 min-w-12 max-w-12 hover:scale-150 relative transition-transform duration-300 cursor-pointer object-cover hover:z-50"
                />
              ))}
            </div>
          </div>
        </div>
      )}
    </div>
  </section>
)}

<style>
  @keyframes scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>
