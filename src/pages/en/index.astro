---
import Header from "../../components/Header.astro";
import Hero from "../../components/Hero.astro";
import About from "../../components/About.astro";
import Projects from "../../components/Projects.astro";
import Experience from "../../components/Experience.astro";
import Education from "../../components/Education.astro";
import Certifications from "../../components/Certifications.astro";
import Contact from "../../components/Contact.astro";
import Footer from "../../components/Footer.astro";
import { siteConfig } from "../../config";
import { fetchGitHubProjects } from "../../lib/github";
import { loadLinkedInData, mergeSkills } from "../../lib/linkedin";
import { translateConfig, translateGitHubProjects, translateLinkedInData } from "../../lib/translate";
import "../../styles/global.css";

const rawGithubProjects = await fetchGitHubProjects("huneyoliv");
const rawLinkedin = loadLinkedInData();

const translated = await translateConfig(
  { ...siteConfig } as unknown as Record<string, unknown>,
  "en"
);
const githubProjects = await translateGitHubProjects(rawGithubProjects as any[], "en");
const linkedin = await translateLinkedInData(rawLinkedin as any, "en");
const allSkills = mergeSkills(siteConfig.skills, rawLinkedin.skills);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={translated.description as string} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap"
      rel="stylesheet"
    />
    <title>{siteConfig.name} - {translated.title as string}</title>
  </head>
  <body class="bg-white dark:bg-neutral-950 text-neutral-900 dark:text-white antialiased">
    <Header lang="en" hasExperience={(linkedin.experience?.length ?? 0) > 0} hasCertifications={(linkedin.certifications?.length ?? 0) > 0} />
    <main class="pt-16">
      <Hero lang="en" translatedTitle={translated.title as string} />
      <About lang="en" translatedAboutMe={translated.aboutMe as string} skills={allSkills} />
      <Projects lang="en" translatedProjects={githubProjects as any[]} />
      <Experience lang="en" experiences={linkedin.experience as any[]} />
      <Education lang="en" translatedEducation={translated.education as any[]} linkedinEducation={linkedin.education as any[]} />
      <Certifications lang="en" certifications={linkedin.certifications as any[]} />
      <Contact lang="en" />
    </main>
    <Footer lang="en" hasExperience={(linkedin.experience?.length ?? 0) > 0} hasCertifications={(linkedin.certifications?.length ?? 0) > 0} />
  </body>
</html>
